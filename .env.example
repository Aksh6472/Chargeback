# ==========================================================
# Chargeback Evidence AI - Environment Variables
# ==========================================================

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL / pgvector Direct Connection (Optional - defaults to Supabase REST / local SQLite)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# API Gateway & Backend Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_API_URL=http://localhost:8000

# Streamlit Frontend Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_BASE=dark

# n8n Orchestration Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chargeback-evidence-pipeline

# Tesseract OCR Path (Optional on Windows if not in PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=tesseract
